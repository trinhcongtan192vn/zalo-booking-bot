# ==============================================
# ZALO BOOKING BOT - ENVIRONMENT VARIABLES
# ==============================================
# Project: VC-ZBB-1225
# Phase: 1 (MVP)
#
# HƯỚNG DẪN:
# 1. Copy file này thành `.env.local` trong thư mục `src/`
# 2. Điền các giá trị thực tế vào từng biến
# 3. KHÔNG commit file `.env.local` lên Git
#
# ==============================================

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
#
# LOCAL: postgresql://postgres:your_password@localhost:5432/zalo_booking_bot
# PRODUCTION: Get from Neon.tech, Supabase, Railway, etc.
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/zalo_booking_bot"

# ==============================================
# NEXTAUTH.JS CONFIGURATION
# ==============================================
# NextAuth secret key (minimum 32 characters)
# Generate: openssl rand -base64 32
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="your-secret-key-min-32-chars-replace-this"

# Google OAuth Credentials
# Get from: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID
# 2. Application type: Web application
# 3. Authorized redirect URIs:
#    - Local: http://localhost:3000/api/auth/callback/google
#    - Production: https://your-domain.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-your-google-client-secret"

# NextAuth base URL
# LOCAL: http://localhost:3000
# PRODUCTION: https://your-domain.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ==============================================
# ZALO OA API CONFIGURATION
# ==============================================
# Zalo Official Account API Base URL
# Default: https://openapi.zalo.me/v3.0/oa
# (Thường không cần thay đổi)
ZALO_API_BASE_URL="https://openapi.zalo.me/v3.0/oa"

# ==============================================
# NODE ENVIRONMENT
# ==============================================
# Environment: development | production | test
NODE_ENV="development"

# ==============================================
# OPTIONAL: MONITORING & LOGGING
# ==============================================
# Sentry DSN for error tracking (optional)
# Get from: https://sentry.io
# SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# Vercel Analytics (optional, auto-enabled on Vercel)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID="prj_..."

# ==============================================
# NOTES
# ==============================================
# - Zalo OA credentials (zaloOaId, zaloAccessToken) được lưu trong DATABASE
#   (table: shops), KHÔNG lưu trong environment variables
# - Multi-shop architecture: Mỗi shop có riêng Zalo credentials trong DB
# - Production: Cần setup tất cả biến trên Vercel Dashboard
# ==============================================
